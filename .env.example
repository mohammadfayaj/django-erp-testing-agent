# ERP Test Agent Environment Configuration
# Copy this file to .env and fill in your values

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=local                        # local | dev | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
ARTIFACT_DIR=./artifacts             # where screenshots/traces/reports are saved

# ── Target ERP ───────────────────────────────────────────────────────────────
ERP_BASE_URL=http://localhost:8000
ERP_ADMIN_URL=http://localhost:8000/admin/

# ── Default credentials (override per-role in configs/roles.yaml) ─────────────
ERP_ADMIN_USER=admin
ERP_ADMIN_PASSWORD=changeme

# ── Playwright ────────────────────────────────────────────────────────────────
BROWSER=chromium                     # chromium | firefox | webkit
HEADLESS=true
SLOW_MO=0                            # ms between actions (useful for debugging)
BROWSER_TIMEOUT=30000                # default action timeout in ms

# ── LLM Planner (optional – set if using LLM-assisted step expansion) ─────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0

# ── Database verification (optional read-only DSN for staging) ────────────────
DB_VERIFY_DSN=

# ── API verification ──────────────────────────────────────────────────────────
API_TOKEN=
